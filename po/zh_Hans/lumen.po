msgid "The check could not be completed. Update status cannot be determined."
msgstr "检查未能完成，目前不能确定更新状态。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Release notes from %s to %s (%d releases)"
msgstr "从 %s 到 %s 的更新记录（共 %d 个版本）"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Open this release on GitHub"
msgstr "在 GitHub 查看此版本"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "No release notes were provided for this version."
msgstr "此版本没有提供更新说明。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Downloads for %s (%s)"
msgstr "%s 的下载文件（%s）"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "The package format matches this installation. Check the target release’s firmware and LuCI requirements before installing."
msgstr "以下包格式与当前安装匹配。安装前仍请核对目标版本要求的固件和 LuCI 版本。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Verify the signing key and package signatures before installing. A checksum alone does not authenticate the publisher."
msgstr "安装前请核对公钥并验证签名。仅凭哈希校验不能证明发布者身份。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Download the files, then confirm installation in the LuCI package manager. This page does not install them."
msgstr "下载文件后，由你在 LuCI 软件包管理页确认安装；本页不会代为安装。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "This release has no theme package matching the installed package format."
msgstr "此版本没有与当前包格式匹配的主题安装包。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Some assets were omitted because their download links or upload state could not be verified."
msgstr "部分附件的下载链接或上传状态无法核实，已省略显示。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "The selected version cannot be compared safely. Please check again."
msgstr "无法可靠比较所选版本，请重新检查。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "To install a downloaded package, open Software from the System menu."
msgstr "要安装已下载的软件包，请从“系统”菜单进入“软件包”。"
