msgstr "可选字体包"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Simplified Chinese package"
msgstr "简体中文包"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Verification key"
msgstr "验签公钥"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Checksums / signature"
msgstr "校验清单／签名"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Check GitHub for updates"
msgstr "检查更新"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Updates are checked only when you press the button."
msgstr "仅在点击按钮后检查更新，不会自动升级。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Installed version or package format is unavailable. Update status cannot be determined."
msgstr "无法读取已安装版本或包格式，目前不能确定更新状态。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "This page checks and downloads releases only. It never installs updates or changes router settings."
msgstr "本页用于检查更新和下载安装包，不会执行安装或修改路由器设置。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "The check connects this browser to the public GitHub API without a token or login credentials."
msgstr "检查时由此浏览器连接 GitHub 公开接口，不发送密钥或登录凭据。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Open GitHub releases"
msgstr "打开 GitHub 发布页面"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Open LuCI package manager"
msgstr "打开 LuCI 软件包管理"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Installed version: %s · Package format: %s"
msgstr "当前版本：%s · 安装包格式：%s"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Installed version: unknown"
msgstr "当前版本：未知"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Checking releases… Please wait."
msgstr "正在检查发布记录，请稍候…"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "The check is incomplete. Update status and the full release-note range cannot be determined."
msgstr "检查未完成，不能确定更新状态，也无法保证已获取完整的跨版本更新记录。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "No version selection or downloads are shown for incomplete results. Open GitHub releases or try again."
msgstr "记录不完整时暂不提供版本选择与下载，请打开 GitHub 发布页面查看或重试。"

#: htdocs/luci-static/resources/view/lumen/updates.js
