#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Updates"
msgstr "检查更新"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Lumen updates"
msgstr "Lumen 主题更新"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "The check timed out. Try again later."
msgstr "检查超时，请稍后重试。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "GitHub refused or rate-limited the request. Try again later."
msgstr "GitHub 拒绝了请求或限制了请求频率，请稍后重试。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "The release history exceeds the 10-page limit. The results are incomplete."
msgstr "发布记录超过了 10 页上限，结果尚不完整。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Some stable release tags could not be compared as semantic versions."
msgstr "部分正式版标签无法按版本号比较。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Different releases have the same version number. The results need manual review."
msgstr "不同发布记录使用了相同版本号，需要人工核对。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "The release history changed during this check. Please check again."
msgstr "检查过程中发布记录发生变化，请重新检查。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "GitHub returned unexpected release data."
msgstr "GitHub 返回的发布数据格式异常。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "GitHub returned an error. Try again later."
msgstr "GitHub 返回错误，请稍后重试。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Could not reach GitHub. Check this browser’s connection and try again."
msgstr "无法连接 GitHub，请检查此浏览器的网络连接后重试。"

#: htdocs/luci-static/resources/view/lumen/updates.js
msgid "Theme package"
msgstr "主题安装包"

#: htdocs/luci-static/resources/view/lumen/updates.js
