{#
 LuCI Lumen theme — footer template.
 Based on luci-theme-bootstrap (Apache License 2.0).
-#}

		{% if (!blank_page): %}
				</div>
				<footer class="page-footer">
					<span>
						<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} ({{ version.luciversion }})</a>
						<span class="dot">·</span>
						<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
						{% if (lua_active): %}
							<span class="dot">·</span> {{ _('Lua compatibility mode active') }}
						{% endif %}
					</span>
				</footer>
			</div>
		</div>
		<script>L.require('menu-lumen')</script>
		{% endif %}
	</body>
</html>
