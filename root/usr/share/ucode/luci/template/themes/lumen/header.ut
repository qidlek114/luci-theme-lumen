{#
 LuCI Lumen theme — header template.
 Based on luci-theme-bootstrap (Apache License 2.0).
-#}

{%
	import { getuid, getspnam } from 'luci.core';
	import { stat } from 'fs';
	import { cursor } from 'uci';

	const boardinfo = ubus.call('system', 'board');
	const ver = stat('/www/luci-static/lumen/lumen.css')?.mtime ?? 1;

	/* appearance settings (Lumen → Appearance) */
	const sc = cursor().get_all('lumen', 'main') ?? {};
	const style = (sc.style == 'claude') ? 'claude' : 'default';
	const forced = (sc.mode == 'light' || sc.mode == 'dark') ? sc.mode : null;
	const hostname = striptags(sc.hostname || boardinfo.hostname || '?');
	const model = striptags(sc.model || boardinfo.model || (version.distname ?? 'OpenWrt'));

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-mode="{{ forced ?? 'system' }}" data-style="{{ style }}"{{ forced ? ' data-mode-locked' : '' }}>
	<head>
		<meta charset="utf-8">
		<title>{{ entityencode(striptags(`${hostname}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`), true) }}</title>
		<script>
			(function() {
				var root = document.documentElement,
				    mq = window.matchMedia('(prefers-color-scheme: dark)'),
				    forced = {{ forced ? `'${forced}'` : 'null' }},
				    mode = null;

				window.lumenConfig = {{ sprintf('%J', { hostname: hostname, model: model, style: style, mode: forced ?? 'auto', ver: `${ver}-${stat('/usr/share/luci/menu.d/luci-theme-lumen.json')?.mtime ?? 0}` }) }};

				try {
					[ 'mode', 'sidebar', 'rate-unit', 'bw-dev' ].forEach(function(k) {
						var old = localStorage.getItem('shadcn-' + k);
						if (old != null && localStorage.getItem('lumen-' + k) == null) localStorage.setItem('lumen-' + k, old);
					});
				} catch (e) {}

				try { mode = forced || localStorage.getItem('lumen-mode'); } catch (e) { mode = forced; }
				try { if (localStorage.getItem('lumen-sidebar') == 'collapsed') root.classList.add('sidebar-collapsed'); } catch (e) {}

				function apply() {
					var m = (mode == 'light' || mode == 'dark') ? mode : 'system';
					root.setAttribute('data-mode', m);
					root.setAttribute('data-darkmode', m == 'dark' || (m == 'system' && mq.matches));
				}

				window.lumenSetMode = function(m) {
					if (forced)
						return;

					mode = m;
					try { localStorage.setItem('lumen-mode', m); } catch (e) {}
					apply();
				};

				if (mq.addEventListener) mq.addEventListener('change', apply);
				else if (mq.addListener) mq.addListener(apply);
				apply();
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="theme-color" content="{{ style == 'claude' ? '#f0ece3' : '#fafafa' }}" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="{{ style == 'claude' ? '#0d0d0d' : '#18181b' }}" media="(prefers-color-scheme: dark)">
		<meta name="apple-mobile-web-app-capable" content="yes">
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
		<meta name="apple-mobile-web-app-title" content="{{ entityencode(hostname, true) }}">
		<link rel="apple-touch-icon" href="{{ media }}/logo.svg">
		<meta name="darkreader-lock">
		<link rel="preload" href="{{ media }}/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="stylesheet" href="{{ media }}/fonts.css?v={{ ver }}">
		<link rel="stylesheet" href="{{ media }}/base.css?v={{ ver }}">
		<link rel="stylesheet" href="{{ media }}/mobile.css?v={{ ver }}">
		<link rel="stylesheet" href="{{ media }}/lumen.css?v={{ ver }}">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ ver }}-{{ stat(`/usr/lib/lua/luci/i18n/lumen.${dispatcher.lang}.lmo`)?.mtime ?? 0 }}"></script>
		<script src="{{ resource }}/cbi.js?v={{ ver }}"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}{{ blank_page ? ' blank-page' : '' }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<div class="app">
			<aside class="sidebar" id="sidebar">
				<a class="sidebar-brand" href="{{ dispatcher.build_url('admin/lumen/dashboard') }}">
					<span class="brand-logo">
						<svg viewBox="0 0 24 24" fill="none" stroke="url(#brand-grad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><defs><linearGradient id="brand-grad" x1="2" y1="4" x2="22" y2="22" gradientUnits="userSpaceOnUse"><stop offset="0" style="stop-color:var(--brand-1)"/><stop offset=".55" style="stop-color:var(--brand-2)"/><stop offset="1" style="stop-color:var(--brand-3)"/></linearGradient></defs><rect width="20" height="8" x="2" y="14" rx="2"/><path d="M6.01 18H6"/><path d="M10.01 18H10"/><path d="M15 10v4"/><path d="M17.84 7.17a4 4 0 0 0-5.66 0"/><path d="M20.66 4.34a8 8 0 0 0-11.31 0"/></svg>
					</span>
					<span class="brand-text">
						<span class="brand-name">{{ entityencode(hostname, true) }}</span>
						<span class="brand-model">{{ entityencode(model, true) }}</span>
					</span>
				</a>
				<nav class="sidebar-nav" id="mainmenu"></nav>
				<div class="sidebar-footer" id="sidebar-footer">
					<ul class="mode-menu" id="modemenu" style="display:none"></ul>
				</div>
			</aside>
			<div class="sidebar-overlay" id="sidebar-overlay"></div>

			<div class="main">
				<header class="topbar">
					<button type="button" class="icon-btn" id="sidebar-toggle" title="{{ _('Toggle sidebar') }}" aria-label="{{ _('Toggle sidebar') }}">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
					</button>
					<span class="topbar-sep"></span>
					<ol class="crumbs" id="breadcrumb"></ol>
					<div class="topbar-right">
						<div id="indicators"></div>
						{% if (!forced): %}
						<button type="button" class="icon-btn" id="theme-toggle" title="{{ _('Theme') }}" aria-label="{{ _('Theme') }}">
							<svg class="i-system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
							<svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
							<svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
						</button>
						{% endif %}
					</div>
				</header>

				<div id="maincontent" class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
						<div class="alert-message warning">
							<h4>{{ _('No password set!') }}</h4>
							<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
							{% if (dispatcher.lookup("admin/system/admin")): %}
							  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					{% if (boardinfo.rootfs_type == "initramfs"): %}
						<div class="alert-message warning">
							<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
							<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
							{% if (dispatcher.lookup("admin/system/flash")): %}
							  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
		{% endif %}
